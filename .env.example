# Copy to .env at the repository root. Never commit .env.

NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# MongoDB connection. For local development use: mongodb://127.0.0.1:27017/droppool
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB_NAME=droppool

# Required in production. At least 24 characters.
JWT_SECRET=replace-with-a-long-random-string-at-least-24-chars
JWT_EXPIRES_IN=12h

# Comma-separated. Each domain is trimmed and lowercased.
COLLEGE_EMAIL_DOMAINS=banasthali.in,demo.droppool.test

# Comma-separated hostel names for Banasthali Vidyapeeth
HOSTELS=Shri Shanta Teertham Hostel,Shri Shanta Nikay,Shri Shanta Sthaaniyam,Shri Shanta Neri,Shri Shanta Lok,Shri Shanta Sharanam

# Labels seeded records.
DEMO_MODE=true

# Server-side only. Used for cart screenshot extraction via Gemini.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Leave empty in local dev so the Vite proxy forwards /api to the server.
# Set this to the public API origin before a production client build.
VITE_API_URL=

# Campus matching (Phase 1/2). Tune for your campus.
MAX_PROXIMITY_TIER=3
NEAR_MIN=7
ENABLE_CAMPUS_WIDE=false
MIN_MARGINAL_SAVING_PAISE=500
MAX_GROUP_SIZE=4
TZ_OFFSET_MINUTES=330

# Production: comma-separated list allowed, e.g. https://droppool.vercel.app,http://localhost:5173
# (no trailing slash needed, it is stripped)
